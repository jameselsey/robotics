# Non-secret configuration only. Copy to .env and review on the target board.
ROBOT_UID=1000
ROBOT_GID=1000
ROS_DOMAIN_ID=0
FOXGLOVE_PORT=8765
# Separate ports avoid disturbing the existing standalone voice prototype.
WAKE_PORT=10400
ASR_PORT=18085
TTS_PORT=18086
GENIEX_PORT=28181
GENIEX_MODEL=qualcomm/Qwen3-VL-4B-Instruct
# Defaults use the board runtime and model cache; never the neighboring voice repo.
# GENIEX_RUNTIME_DIR=/home/arduino/.local/share/geniex
# GENIEX_CACHE_DIR=/home/arduino/.cache/geniex
# WAKE_MODELS_DIR=./runtime/models/wakeword
# ASR_MODELS_DIR=./runtime/models/asr
# TTS_MODELS_DIR=./runtime/models/tts
CAMERA_DEVICE=/dev/video0
LIDAR_DEVICE=/dev/ttyUSB0
INPUT_DEVICE_DIR=/dev/input
AUDIO_DEVICE_DIR=/dev/snd
ROUTER_SOCKET=/var/run/arduino-router.sock
AUDIO_GID=29
VIDEO_GID=44
INPUT_GID=996
DIALOUT_GID=20
ROUTER_GID=0
AUDIO_INPUT_NAME=Brio
AUDIO_OUTPUT_NAME=
AWS_PROFILE=default
AWS_REGION=us-east-1
# AWS_DIR=/home/arduino/.aws
