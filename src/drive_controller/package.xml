<?xml version="1.0"?>
<package format="3">
  <name>drive_controller</name>
  <version>0.0.1</version>
  <description>Drives the RoboPi BTS7960 motors and publishes encoder odometry</description>

  <maintainer email="jelsey@example.com">James Elsey</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
