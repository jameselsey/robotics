  <version>0.0.1</version>
  <description>Canonical Xacro and generated URDF for the Xiaor Geek tank robot</description>
  <maintainer email="james.elsey@gmail.com">James Elsey</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>xacro</build_depend>

  <exec_depend>robot_state_publisher</exec_depend>

